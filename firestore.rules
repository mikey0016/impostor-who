rules_version = '2';
/* ============================================================
   Ayg'oqchi — Firestore qoidalari (anti-cheat bilan)
   - Profilni faqat egasi yoza oladi
   - Bir yozishda coin +100 dan oshmasligi shart
     (o'yin +10/+20, ovoz +5/+30, kunlik +50, ro'yxat +100)
   - Reyting hammaga ochiq (shaxsiy email saqlanmaydi!)
   ============================================================ */
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.coins == 100
        && request.resource.data.keys().hasOnly(
          ['name', 'coins', 'games', 'wins', 'spyWins',
           'lastDaily', 'inv', 'createdAt', 'updatedAt']);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= resource.data.coins + 100
        && request.resource.data.keys().hasOnly(
          ['name', 'coins', 'games', 'wins', 'spyWins',
           'lastDaily', 'inv', 'createdAt', 'updatedAt']);
    }

    /* ============================================================
       ONLINE xonalar (kod bilan kirish, 3–20 o'yinchi)
       - rooms/{CODE}: ochiq o'qish (kodni bilgan kiradi),
         yozish: host to'liq, boshqalar faqat o'zi qo'shilishi/chiqishi
       - secrets/{uid}: faqat egasi o'qiydi, faqat host yozadi
       ============================================================ */
    match /rooms/{code} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.playerUids == [request.auth.uid]
        && request.resource.data.players.size() == 1
        && request.resource.data.keys().hasOnly(
          ['hostUid', 'hostName', 'status', 'createdAt', 'expiresAt',
           'settings', 'players', 'playerUids', 'roundNo', 'round',
           'result', 'updatedAt']);

      allow update: if request.auth != null && (
        // host: sozlash, tur boshlash, ochish, yopish
        resource.data.hostUid == request.auth.uid
        // o'yinchi: faqat o'zi qo'shiladi yoki chiqadi (lobby'da)
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['players', 'playerUids', 'hostUid', 'hostName', 'updatedAt'])
            && request.resource.data.status == 'lobby'
            && resource.data.status == 'lobby'
            && request.resource.data.players.size() <= 20
            && request.resource.data.playerUids.size() <= 20
            && request.resource.data.playerUids.size()
               == request.resource.data.players.size())
      );

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.playerUids;

      match /secrets/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(code))
               .data.hostUid == request.auth.uid;
      }
    }
  }
}
