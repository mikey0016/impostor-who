rules_version = '2';
/* ============================================================
   Ayg'oqchi — Firestore qoidalari (anti-cheat bilan)
   - Profilni faqat egasi yoza oladi
   - Bir yozishda coin +100 dan oshmasligi shart
     (o'yin +10/+20, ovoz +5/+30, kunlik +50, ro'yxat +100)
   - Reyting hammaga ochiq (shaxsiy email saqlanmaydi!)
   ============================================================ */
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.coins == 100
        && request.resource.data.keys().hasOnly(
          ['name', 'coins', 'games', 'wins', 'spyWins',
           'lastDaily', 'inv', 'createdAt', 'updatedAt']);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= resource.data.coins + 100
        && request.resource.data.keys().hasOnly(
          ['name', 'coins', 'games', 'wins', 'spyWins',
           'lastDaily', 'inv', 'createdAt', 'updatedAt']);
    }
  }
}
